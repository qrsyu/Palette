# Palette figure style. Built from CONFIG in Palette/figure.py: edit the numbers there, not here.
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 6
mathtext.default: regular

xtick.labelsize: 7
ytick.labelsize: 7
axes.labelsize: 7
axes.titlesize: 8
figure.titlesize: 8
legend.fontsize: 6
legend.title_fontsize: 6

axes.linewidth: 0.5
lines.linewidth: 1.0
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler(color=['226abe', 'a93c77', '627402', '985a05', '5c5c5c'])

xtick.direction: out
ytick.direction: out
xtick.major.size: 2
ytick.major.size: 2
xtick.minor.size: 1.0
ytick.minor.size: 1.0
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.minor.width: 0.5
ytick.minor.width: 0.5

pdf.fonttype: 42
ps.fonttype: 42
savefig.bbox: standard
